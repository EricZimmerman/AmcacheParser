<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- a single file publish includes the native SQLite library (Microsoft.Data.Sqlite) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyTitle>AmcacheParser</AssemblyTitle>
    <Company>Eric Zimmerman</Company>
    <Product>AmcacheParser</Product>
    <Description>Parses Amcache.hve and the Amcache SQLite databases</Description>
    <Copyright>Eric Zimmerman</Copyright>
    <Version>2026.10.0</Version>
    <LangVersion>10</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Custom-Icon-Design-Flatastic-2-Process-info.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Custom-Icon-Design-Flatastic-2-Process-info.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Amcache\Amcache.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Exceptionless" Version="6.2.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="ServiceStack.Text" Version="10.4.2" />
  </ItemGroup>
</Project>